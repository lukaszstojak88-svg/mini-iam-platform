# Copy to .env and set your own values. The .env file is excluded from Git.
# "change-me" values are placeholders - never use them outside a local environment.

# --- Ports (published on 127.0.0.1 only) ---
POSTGRES_PORT=5432
KEYCLOAK_PORT=8080
USER_SERVICE_PORT=8081
AUTH_SERVICE_PORT=8082
AUDIT_SERVICE_PORT=8083
ELASTICSEARCH_PORT=9200
KIBANA_PORT=5601

# --- PostgreSQL ---
POSTGRES_SUPERUSER_PASSWORD=change-me
USER_SERVICE_DB_PASSWORD=change-me
AUDIT_SERVICE_DB_PASSWORD=change-me
KEYCLOAK_DB_PASSWORD=change-me

# --- Keycloak ---
# Keycloak admin console user (master realm)
KEYCLOAK_ADMIN_USERNAME=kc-admin
KEYCLOAK_ADMIN_PASSWORD=change-me
# Secret of the technical client mini-iam-admin (Client Credentials)
MINI_IAM_ADMIN_CLIENT_SECRET=change-me
# Password of the application user "admin" (ADMIN role) in the mini-iam realm
MINI_IAM_ADMIN_PASSWORD=change-me

# --- ELK ("elk" profile) ---
ELASTIC_PASSWORD=change-me
KIBANA_SYSTEM_PASSWORD=change-me
LOGSTASH_WRITER_PASSWORD=change-me

# --- Frontend / CORS ---
# Comma-separated list of origins allowed to call the APIs
CORS_ALLOWED_ORIGINS=http://localhost:4200
