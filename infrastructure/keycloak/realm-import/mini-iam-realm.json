{
  "realm": "mini-iam",
  "displayName": "Mini IAM",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "rememberMe": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "roles": {
    "realm": [
      { "name": "ADMIN", "description": "Full management of users and roles, read access to the audit log" },
      { "name": "MANAGER", "description": "Read, create and edit users" },
      { "name": "USER", "description": "Base role: read and edit own profile" },
      { "name": "AUDITOR", "description": "Read-only access to audit events" },
      { "name": "SERVICE", "description": "Technical role of service accounts (service-to-service calls)" },
      {
        "name": "default-roles-mini-iam",
        "description": "Default roles of the realm",
        "composite": true,
        "composites": { "realm": ["USER"] }
      }
    ]
  },
  "defaultRole": { "name": "default-roles-mini-iam" },
  "scopeMappings": [
    { "client": "mini-iam-frontend", "roles": ["ADMIN", "MANAGER", "USER", "AUDITOR"] },
    { "client": "mini-iam-service", "roles": ["SERVICE"] }
  ],
  "clientScopeMappings": {
    "realm-management": [
      { "client": "mini-iam-admin", "roles": ["view-users", "query-users", "manage-users", "view-realm"] }
    ]
  },
  "clients": [
    {
      "clientId": "mini-iam-frontend",
      "name": "Mini IAM Frontend",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": false,
      "frontchannelLogout": true,
      "rootUrl": "http://localhost:4200",
      "baseUrl": "/",
      "redirectUris": ["http://localhost:4200/*"],
      "webOrigins": ["http://localhost:4200"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:4200/*"
      },
      "protocolMappers": [
        {
          "name": "mini-iam-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "mini-iam-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "mini-iam-admin",
      "name": "Mini IAM Keycloak Admin API client (technical)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${MINI_IAM_ADMIN_CLIENT_SECRET}",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "fullScopeAllowed": false,
      "defaultClientScopes": ["basic", "roles", "profile", "email", "web-origins", "acr", "kc-admin-api"],
      "optionalClientScopes": []
    },
    {
      "clientId": "mini-iam-service",
      "name": "Mini IAM service-to-service client (technical)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${MINI_IAM_SERVICE_CLIENT_SECRET}",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "fullScopeAllowed": false,
      "defaultClientScopes": ["basic", "roles", "profile", "email", "web-origins", "acr"],
      "optionalClientScopes": [],
      "protocolMappers": [
        {
          "name": "mini-iam-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "mini-iam-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "service-account-mini-iam-admin",
      "enabled": true,
      "serviceAccountClientId": "mini-iam-admin",
      "realmRoles": ["SERVICE"],
      "clientRoles": {
        "realm-management": ["view-users", "query-users", "manage-users", "view-realm"]
      }
    },
    {
      "username": "service-account-mini-iam-service",
      "enabled": true,
      "serviceAccountClientId": "mini-iam-service",
      "realmRoles": ["SERVICE"]
    },
    {
      "username": "admin",
      "enabled": true,
      "email": "admin@example.com",
      "emailVerified": true,
      "firstName": "Admin",
      "lastName": "Mini IAM",
      "credentials": [
        { "type": "password", "value": "${MINI_IAM_ADMIN_PASSWORD}", "temporary": false }
      ],
      "realmRoles": ["default-roles-mini-iam", "ADMIN"]
    }
  ]
}
