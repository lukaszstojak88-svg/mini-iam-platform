{
  "info": {
    "_postman_id": "843e767e-d412-5c4f-b8e1-35af193663fc",
    "name": "Mini IAM Platform",
    "description": "Requesty API Mini IAM (user-service :8081, auth-service :8082, audit-service :8083). Instrukcja: `docs/postman/README.md`.\n\nDomyślne uwierzytelnienie kolekcji: OAuth 2.0 Authorization Code + PKCE (klient publiczny `mini-iam-frontend`). Każde żądanie dostaje `X-Correlation-Id` (skrypt kolekcji), żeby można je było odnaleźć w logach i Kibanie.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "oauth2",
    "oauth2": [
      {
        "key": "grant_type",
        "value": "authorization_code_with_pkce",
        "type": "string"
      },
      {
        "key": "authUrl",
        "value": "{{keycloakUrl}}/realms/{{realm}}/protocol/openid-connect/auth",
        "type": "string"
      },
      {
        "key": "accessTokenUrl",
        "value": "{{keycloakUrl}}/realms/{{realm}}/protocol/openid-connect/token",
        "type": "string"
      },
      {
        "key": "clientId",
        "value": "{{frontendClientId}}",
        "type": "string"
      },
      {
        "key": "redirect_uri",
        "value": "{{redirectUri}}",
        "type": "string"
      },
      {
        "key": "useBrowser",
        "value": false,
        "type": "boolean"
      },
      {
        "key": "scope",
        "value": "openid",
        "type": "string"
      },
      {
        "key": "challengeAlgorithm",
        "value": "S256",
        "type": "string"
      },
      {
        "key": "client_authentication",
        "value": "body",
        "type": "string"
      },
      {
        "key": "tokenName",
        "value": "mini-iam user token",
        "type": "string"
      },
      {
        "key": "addTokenTo",
        "value": "header",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Correlation id for tracing in logs (spec §16.2): keep an explicit header, otherwise generate one.",
          "if (!pm.request.headers.has('X-Correlation-Id')) {",
          "    pm.request.headers.add({ key: 'X-Correlation-Id', value: 'postman-' + Date.now() });",
          "}",
          "// Unique username for 'Utworzenie użytkownika' (generated once; clear the variable for a new one).",
          "if (!pm.environment.get('newUsername')) {",
          "    pm.environment.set('newUsername', 'john.doe.' + Date.now());",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "00 Tokeny",
      "description": "Token użytkownika (Authorization Code + PKCE) jest skonfigurowany na poziomie kolekcji: zakładka *Authorization* kolekcji → *Get New Access Token* → logowanie (np. `admin`) → *Use Token*. Token serwisowy (Client Credentials) pobiera request poniżej.",
      "item": [
        {
          "id": "0c50c903-7d21-5a02-9eff-350f949a1c56",
          "name": "Token serwisowy (client_credentials)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{keycloakUrl}}/realms/{{realm}}/protocol/openid-connect/token",
              "host": [
                "{{keycloakUrl}}"
              ],
              "path": [
                "realms",
                "{{realm}}",
                "protocol",
                "openid-connect",
                "token"
              ]
            },
            "description": "Token klienta technicznego `mini-iam-service` (tylko rola `SERVICE`, bez ról aplikacyjnych i bez uprawnień Admin API), zapisywany w zmiennej `serviceToken`. Sekret: zmienna środowiska `serviceClientSecret` = `MINI_IAM_SERVICE_CLIENT_SECRET` z `.env`.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "grant_type",
                  "value": "client_credentials"
                },
                {
                  "key": "client_id",
                  "value": "{{serviceClientId}}"
                },
                {
                  "key": "client_secret",
                  "value": "{{serviceClientSecret}}"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.expect(pm.response.code).to.be.oneOf([200]));",
                  "pm.environment.set('serviceToken', pm.response.json().access_token);"
                ]
              }
            }
          ]
        }
      ]
    },
